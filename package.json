{
  "name": "blog",
  "version": "0.1.189",
  "homepage": "https://philp.io",
  "repository": "https://github.com/chrismphilp/philp.io",
  "description": "My personal blog",
  "author": "Chris Philp",
  "license": "MIT",
  "scripts": {
    "format": "prettier --write \"**/*.tsx\"",
    "dev": "next dev",
    "patch": "npm version --no-commit-hooks --no-git-tag-version patch && git add package.json package-lock.json && git commit -m \"[main] | Bumping version\"",
    "build": "next build",
    "start": "npx serve@latest out",
    "static": "next build && next-image-export-optimizer",
    "build:cloudflare": "next build --webpack && next-image-export-optimizer",
    "lint": "eslint ."
  },
  "pre-push": [
    "format",
    "lint",
    "patch"
  ],
  "engines": {
    "npm": ">=8.0.0",
    "node": "^22.14.0 || ^24.0.0"
  },
  "dependencies": {
    "@ducanh2912/next-pwa": "^10.2.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "0.5.20",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "gray-matter": "4.0.3",
    "next": "^16.4.0",
    "next-image-export-optimizer": "1.21.1",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "postcss": "^8.5.29",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-icons": "5.7.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-img-size": "1.0.1",
    "rehype-pretty-code": "^0.14.5",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "typescript": "~6.0.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.4.0",
    "baseline-browser-mapping": "^2.11.28",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.0",
    "pre-push": "^0.1.4",
    "prettier": "3.9.10",
    "tailwindcss": "^4.3.3",
    "vercel": "^63.1.2",
    "webpack": "^5.111.1"
  },
  "optionalDependencies": {
    "@img/sharp-linux-x64": "0.35.5",
    "@next/swc-linux-x64-gnu": "16.4.0",
    "@next/swc-linux-x64-musl": "16.4.0",
    "@tailwindcss/oxide-linux-x64-gnu": "4.3.3",
    "@tailwindcss/oxide-linux-x64-musl": "4.3.3",
    "lightningcss-linux-x64-gnu": "1.32.0",
    "lightningcss-linux-x64-musl": "1.32.0"
  },
  "overrides": {
    "@vercel/container": {
      "tar": "7.5.22"
    }
  }
}
